<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
		<!-- <GenerateDocumentationFile>True</GenerateDocumentationFile>  для формирвования xml файла с комментариями приложения-->
    </PropertyGroup>

    <ItemGroup>
      <Content Include="..\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="alglib.net" Version="3.19.0" />
      <PackageReference Include="AWSSDK.S3" Version="4.0.104.5" />
      <PackageReference Include="DotNetEnv" Version="3.2.0" />
      <PackageReference Include="HtmlAgilityPack" Version="1.13.1" />
      <PackageReference Include="Keycloak.AuthServices.Authentication" Version="3.0.0" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.13">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
      <PackageReference Include="NLog" Version="6.2.2" />
      <PackageReference Include="NLog.Config" Version="4.7.15" />
      <PackageReference Include="NLog.Extensions.Logging" Version="6.2.2" />
      <PackageReference Include="NLog.Schema" Version="6.2.2" />
      <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
      <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
      <PackageReference Include="Swashbuckle.AspNetCore.Swagger" Version="10.3.1" />
      <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="10.3.1" />
      <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.1" />
	  <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
	  <PackageReference Include="Keycloak.Net" Version="1.0.18" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Shared\Shared.csproj" />
    </ItemGroup>

</Project>
